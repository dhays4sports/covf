  "compatibilityPolicy": {
    "patch": "May fix defects without removing or renaming frozen members or changing schemas.",
    "minor": "May add optional fields, events, or methods; existing behavior remains compatible.",
    "major": "Required for removals, renames, persistence incompatibility, or required-field semantic changes.",
    "deprecation": "Deprecated members remain supported for at least one minor release and must be documented before removal."
