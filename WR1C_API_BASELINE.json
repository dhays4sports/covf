        "ready": "coveragefit:consultation-checklist-ready",
        "change": "coveragefit:consultation-checklist-change",
        "reset": "coveragefit:consultation-checklist-reset"
      },
      "publicMembers": ["VERSION", "SCHEMA_VERSION", "STORAGE_SCHEMA_VERSION", "STORAGE_PREFIX", "STATUS", "EVENTS", "createEmpty", "createItem", "generateFromPlan", "restoreFromPlan", "save", "setStatus", "activate", "complete", "reopen", "reset", "resetItem", "resetPhase", "clear", "getSnapshot", "getStorageKey", "validateItem", "validateChecklist", "diagnostics", "getSummary", "getProgress", "getRemainingMinutes", "getWorkspaceState"],
      "workspaceStateFields": ["checklist", "summary", "diagnostics", "progress", "currentPhase", "remainingMinutes", "plannerVersion", "version"]
